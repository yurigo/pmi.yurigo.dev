---
import type { CollectionEntry } from "astro:content";
import Header from "../components/Header.astro";
import Sidebar from "../components/Sidebar.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import SessionNavigation from "../components/SessionNavigation.astro";
import { getCollection } from "astro:content";
import "../styles/github-alerts.css";

interface Props {
  entry?: CollectionEntry<"course">;
  title: string;
}

const { entry, title } = Astro.props;
const allEntries = await getCollection("course");
const sorted = allEntries.sort((a, b) => a.data.order - b.data.order);
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | PMI</title>
    <script is:inline>
      if (
        localStorage.getItem("theme") === "dark" ||
        (!localStorage.getItem("theme") &&
          window.matchMedia("(prefers-color-scheme: dark)").matches)
      ) {
        document.documentElement.classList.add("dark");
      }
    </script>
  </head>
  <body
    class="bg-white dark:bg-gray-900 text-gray-900 dark:text-gray-100 min-h-screen"
  >
    <Header />
    <!-- Scroll progress bar -->
    <div
      id="scroll-progress"
      class="fixed top-0 left-0 z-40 h-0.5 bg-indigo-500 transition-all duration-75"
      style="width: 0%; top: 0px"
      aria-hidden="true"
    >
    </div>
    <div class="flex">
      <Sidebar entries={sorted} current={entry?.slug} />
      <main class="flex-1 min-w-0 px-6 py-8 max-w-4xl mx-auto">
        {entry && <Breadcrumbs entry={entry} />}
        <slot />
        {entry && <SessionNavigation entries={sorted} current={entry} />}
      </main>
    </div>
  </body>
</html>

<script>
  const bar = document.getElementById("scroll-progress");
  if (bar) {
    const header = document.getElementById("site-header");

    const updateTop = () => {
      const headerHeight = header?.offsetHeight ?? 0;
      bar.style.top = `${headerHeight}px`;
    };

    const update = () => {
      const scrollTop = window.scrollY;
      const docHeight =
        document.documentElement.scrollHeight - window.innerHeight;
      const pct = docHeight > 0 ? Math.round((scrollTop / docHeight) * 100) : 0;
      bar.style.width = `${pct}%`;
    };

    updateTop();
    window.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", updateTop);
    update();
  }
</script>

<style is:global>
  .course-iframe {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    border: 1px solid #d1d5db;
    border-radius: 12px;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.12);
    background: #fff;
    overflow: hidden;
  }

  @media (max-width: 768px) {
    .course-iframe {
      aspect-ratio: 9 / 16;
      min-height: 70vh;
      max-height: 85svh;
    }
  }

  .dark .course-iframe {
    border-color: #4b5563;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.35);
  }

  html .astro-code {
    background-color: rgba(0, 0, 0, 0.02) !important;
  }

  /* Astro already renders the light theme inline; only override dark mode */
  html.dark .astro-code {
    color: var(--shiki-dark) !important;
    /* background-color: var(--shiki-dark-bg) !important; */
    background-color: rgba(0, 0, 0, 0.2) !important;
  }

  html.dark .astro-code span {
    color: var(--shiki-dark) !important;
    /* background-color: var(--shiki-dark-bg) !important; */
    /* background-color: rgba(0, 0, 0, 0.12) !important; */
  }
</style>
