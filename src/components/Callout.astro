---
type CalloutType = "warning" | "note" | "tip" | "error";

interface Props {
  type?: CalloutType;
  title?: string;
  items?: string[];
}

const { type = "note", title, items } = Astro.props;

const config: Record<CalloutType, { icon: string; label: string; border: string; bg: string; text: string; titleClass: string }> = {
  warning: {
    icon: "⚠️",
    label: "Advertencia",
    border: "border-amber-300 dark:border-amber-700",
    bg: "bg-amber-50 dark:bg-amber-950/40",
    text: "text-amber-900 dark:text-amber-200",
    titleClass: "text-amber-700 dark:text-amber-300",
  },
  error: {
    icon: "🚨",
    label: "Errores comunes",
    border: "border-red-300 dark:border-red-700",
    bg: "bg-red-50 dark:bg-red-950/40",
    text: "text-red-900 dark:text-red-200",
    titleClass: "text-red-700 dark:text-red-300",
  },
  note: {
    icon: "📝",
    label: "Nota",
    border: "border-sky-200 dark:border-sky-700",
    bg: "bg-sky-50 dark:bg-sky-950/40",
    text: "text-sky-900 dark:text-sky-200",
    titleClass: "text-sky-700 dark:text-sky-300",
  },
  tip: {
    icon: "💡",
    label: "Consejo",
    border: "border-teal-200 dark:border-teal-700",
    bg: "bg-teal-50 dark:bg-teal-950/40",
    text: "text-teal-900 dark:text-teal-200",
    titleClass: "text-teal-700 dark:text-teal-300",
  },
};

const c = config[type];
const displayTitle = title ?? c.label;
---

<aside class:list={["not-prose my-6 rounded-xl border p-5", c.border, c.bg]}>
  <p class:list={["mb-3 flex items-center gap-2 text-base font-bold", c.titleClass]}>
    <span aria-hidden="true">{c.icon}</span>
    {displayTitle}
  </p>
  {items && items.length > 0 ? (
    <ul class="space-y-1.5">
      {items.map((item) => (
        <li class:list={["flex items-start gap-2 text-sm", c.text]}>
          <span class="mt-0.5 shrink-0" aria-hidden="true">•</span>
          <span>{item}</span>
        </li>
      ))}
    </ul>
  ) : (
    <slot />
  )}
</aside>
