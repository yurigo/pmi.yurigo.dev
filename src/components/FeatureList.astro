---
interface Feature {
  icon?: string;
  title: string;
  description: string;
}

interface Props {
  heading: string;
  features: Feature[];
}

const { heading, features } = Astro.props;
---

<section class="py-12 px-4">
  <div class="max-w-4xl mx-auto">
    <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white mb-8 text-center">
      {heading}
    </h2>
    <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {features.map(feature => (
        <li class="flex gap-4 p-4 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800">
          {feature.icon && (
            <span class="text-2xl shrink-0" aria-hidden="true">{feature.icon}</span>
          )}
          <div>
            <h3 class="font-semibold text-gray-900 dark:text-gray-100 mb-1">{feature.title}</h3>
            <p class="text-sm text-gray-600 dark:text-gray-400">{feature.description}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
