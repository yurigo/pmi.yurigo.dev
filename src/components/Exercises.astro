---
interface Exercise {
  title: string;
  description: string;
}
interface Props {
  exercises: Exercise[];
}
const { exercises } = Astro.props;
---

<section class="not-prose my-6 rounded-xl border border-emerald-200 bg-emerald-50 p-5 dark:border-emerald-800 dark:bg-emerald-950/40">
  <h2 class="mb-4 flex items-center gap-2 text-lg font-bold text-emerald-700 dark:text-emerald-300">
    <span aria-hidden="true">💻</span> Ejercicios prácticos
  </h2>
  <ol class="space-y-4">
    {exercises.map((ex, i) => (
      <li class="rounded-lg border border-emerald-200 bg-white p-4 shadow-sm dark:border-emerald-700 dark:bg-emerald-950/20">
        <p class="mb-1 font-semibold text-emerald-800 dark:text-emerald-200">
          {i + 1}. {ex.title}
        </p>
        <p class="text-sm text-emerald-700 dark:text-emerald-300">{ex.description}</p>
      </li>
    ))}
  </ol>
</section>
