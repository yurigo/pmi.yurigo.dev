---
interface CTA {
  label: string;
  href: string;
  primary?: boolean;
}

interface Props {
  title: string;
  description: string;
  ctas?: CTA[];
}

const { title, description, ctas = [] } = Astro.props;
---

<section class="py-16 px-4 text-center bg-gradient-to-b from-indigo-50 to-white dark:from-gray-800 dark:to-gray-900">
  <div class="max-w-3xl mx-auto">
    <h1 class="text-4xl sm:text-5xl font-extrabold text-gray-900 dark:text-white leading-tight mb-4">
      {title}
    </h1>
    <p class="text-lg sm:text-xl text-gray-600 dark:text-gray-300 mb-8 leading-relaxed">
      {description}
    </p>
    {ctas.length > 0 && (
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        {ctas.map(cta => (
          <a
            href={cta.href}
            class={
              cta.primary
                ? 'inline-block px-6 py-3 rounded-lg font-semibold text-white bg-indigo-600 hover:bg-indigo-700 dark:bg-indigo-500 dark:hover:bg-indigo-600 transition-colors shadow-md'
                : 'inline-block px-6 py-3 rounded-lg font-semibold text-indigo-600 dark:text-indigo-400 border-2 border-indigo-600 dark:border-indigo-400 hover:bg-indigo-50 dark:hover:bg-gray-800 transition-colors'
            }
          >
            {cta.label}
          </a>
        ))}
      </div>
    )}
  </div>
</section>
